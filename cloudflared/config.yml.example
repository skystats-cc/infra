# Copy to config.yml and fill in your tunnel id (see README: "Cloudflare Tunnel").
tunnel: YOUR-TUNNEL-ID
credentials-file: /etc/cloudflared/credentials.json

ingress:
  # Public API. Admin routes are never reachable from the internet.
  - hostname: api.skystats.cc
    path: ^/admin
    service: http_status:404
  - hostname: api.skystats.cc
    service: http://api:3000

  # Website (its Caddy also proxies /v1 + /healthz to the API, same-origin)
  - hostname: skystats.cc
    service: http://web:80
  - hostname: www.skystats.cc
    service: http://web:80

  - service: http_status:404
