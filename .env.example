# Copy to .env on the server and fill in. Never commit .env.

# Which optional profiles to run: tunnel (public access), monitoring (Uptime Kuma + Dozzle)
COMPOSE_PROFILES=tunnel,monitoring

# Image tags (main = latest merge to main; pin to a version like 0.3.1 for stability)
SERVER_TAG=main
WEB_TAG=main
BOT_TAG=main

# Postgres
POSTGRES_USER=skystats
# Letters and numbers only (it goes into a connection URL)
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=skystats
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB

# Server
LOG_LEVEL=info
ADMIN_API_KEY=change-me-long-random
HYPIXEL_API_KEY=
CORS_ORIGINS=https://skystats.cc
RATE_LIMIT_PER_MIN=120
PUBLIC_WEB_URL=https://skystats.cc

# Stripe (live keys only on the production box). Prices must be VAT-inclusive for UK consumers.
# In the Stripe dashboard: customer portal set to cancel at period end, and Stripe Tax on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated price ids: monthly first, then yearly
STRIPE_PRICES_PRO=
STRIPE_PRICES_MAX=
BILLING_GRACE_DAYS=7
SOFT_RETENTION_DAYS=30

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel). Needed for the "tunnel" profile.
CLOUDFLARE_TUNNEL_TOKEN=

# Discord bot (production application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Discord login: same application as the bot. Add the redirect in Developer Portal → OAuth2.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://skystats.cc/v1/auth/discord/callback
# Shared server ↔ bot secret (openssl rand -hex 32). The API refuses it on requests that came through Cloudflare.
BOT_API_KEY=
# Opt-in roles in the SkyStats server (needs the Server Members intent)
ROLE_SYNC_GUILD_ID=
LINKED_ROLE_ID=
PRO_ROLE_ID=
MAX_ROLE_ID=
# Channel with a self-updating bazaar movers message (optional)
LIVE_BAZAAR_CHANNEL_ID=
# Market: bazaar tax for flip maths; recipes for the craft calculator (check the source's licence first)
BAZAAR_TAX=0.0125
RECIPES_SOURCE_URL=
# Channel ids that get free Hypixel outage alerts (comma-separated)
STATUS_ALERT_CHANNEL_IDS=

# Backups (scripts/backup.sh)
BACKUP_KEEP_DAYS=14
# Optional off-site copy via rclone, e.g. b2:skystats-backups (leave empty to skip).
# Off-site copies are encrypted with age first (UK GDPR security); the copy is refused without a recipient.
RCLONE_REMOTE=
# age public key (age1...). Keep the private key OFF this laptop (password manager / paper).
BACKUP_AGE_RECIPIENT=
# Off-site copies older than this are deleted (the privacy notice promises at most 30 days)
BACKUP_REMOTE_KEEP_DAYS=30
