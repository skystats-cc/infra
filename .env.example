# Copy to .env on the server and fill in. Never commit .env.

# Which optional profiles to run: tunnel (public access), monitoring (Uptime Kuma + Dozzle)
COMPOSE_PROFILES=tunnel,monitoring

# Image tags (main = latest merge to main; pin to a version like 0.3.1 for stability)
SERVER_TAG=main
WEB_TAG=main
BOT_TAG=main

# Postgres
POSTGRES_USER=skystats
# Letters and numbers only (it goes into a connection URL)
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=skystats
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB

# Server
LOG_LEVEL=info
ADMIN_API_KEY=change-me-long-random
HYPIXEL_API_KEY=
CORS_ORIGINS=https://skystats.cc
RATE_LIMIT_PER_MIN=120

# Discord bot (production application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Backups (scripts/backup.sh)
BACKUP_KEEP_DAYS=14
# Optional off-site copy via rclone, e.g. b2:skystats-backups (leave empty to skip)
RCLONE_REMOTE=
